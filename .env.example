# ==============================================================================
# SAT-SA — Supervisory Analytics Tool for SOC Assessment (SIH26157)
# Environment Configuration Template
# ==============================================================================

# Application Environment Mode ('development' | 'production')
APP_ENV=production
NODE_ENV=production

# Server Ports
PORT=3000
HOST_PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=satsa
POSTGRES_USER=satsa_user
POSTGRES_PASSWORD=change_me_sih2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL
# For Container 1 communicating with Container 2 over Docker network:
DATABASE_URL=postgresql://satsa_user:change_me_sih2026@db:5432/satsa

# For host-machine migration scripts running outside Docker:
# DATABASE_URL=postgresql://satsa_user:change_me_sih2026@localhost:5432/satsa

# ------------------------------------------------------------------------------
# Security & JWT Token Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=satsa_supervisory_jwt_secret_key_demo_2026_sih
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
